# Copia questo file in ".env" e adatta i valori. Non inserire mai segreti reali in questo file.
PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/taskflow
# Chiave per firmare i token: in produzione deve essere lunga, casuale e diversa da questa.
JWT_SECRET=cambia-questo-segreto
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
# NODE_ENV=production
